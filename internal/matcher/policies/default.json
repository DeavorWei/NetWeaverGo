{
  "scene": "*",
  "vendor": "*",
  "deviceType": "*",
  "promptPatterns": [
    ">(?:\\s*)$",
    "#(?:\\s*)$",
    "\\](?:\\s*)$"
  ],
  "pagerPatterns": [
    "---- More ----",
    "--More--",
    "---- More",
    "---- More System ----",
    "More:"
  ],
  "confirmPatterns": [
    "\\[Y/N\\]",
    "\\[y/n\\]",
    "\\[confirm\\]"
  ],
  "errorRules": [
    {
      "name": "配置未改变或已存在",
      "pattern": "(?i)(not changed|already exists|no change)",
      "severity": "warning",
      "vendor": "generic",
      "message": "配置与当前运行状态一致"
    },
    {
      "name": "Info告警",
      "pattern": "(?i)(% ?info:|\binfo:|information:)",
      "severity": "warning",
      "vendor": "generic",
      "message": "设备返回一般性通知"
    },
    {
      "name": "命令无法识别",
      "pattern": "(?i)(unrecognized command|unknown command)",
      "severity": "critical",
      "vendor": "generic",
      "message": "设备不认识该命令"
    },
    {
      "name": "命令不完整",
      "pattern": "(?i)(incomplete command|ambiguous command)",
      "severity": "critical",
      "vendor": "generic",
      "message": "命令缺少参数或存在歧义"
    },
    {
      "name": "输入错误",
      "pattern": "(?i)(^Error:|^% ?Error:|^\\\\s*\\\\^\\\\s*$)",
      "severity": "critical",
      "vendor": "generic",
      "message": "设备执行输入返回 Error"
    }
  ],
  "validateModel": "any",
  "needPrompt": true,
  "receiveFilterKeys": [],
  "connectCommandPolicy": 0
}

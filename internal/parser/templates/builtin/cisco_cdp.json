{
  "vendor": "cisco",
  "protocol": "cdp",
  "commandKey": "cdp_neighbor",
  "engine": "aggregate",
  "aggregation": {
    "recordStart": ["^-------------------------", "^Device ID:\\s*(?P<neighbor_name>\\S+)"],
    "captureRules": [
      {
        "pattern": "^Device ID:\\s*(?P<neighbor_name>\\S+)",
        "mode": "set"
      },
      {
        "pattern": "^\\s*IP address:\\s*(?P<neighbor_ip>\\S+)",
        "mode": "set"
      },
      {
        "pattern": "^Platform:\\s*(?P<neighbor_platform>[^,]+)",
        "mode": "set"
      },
      {
        "pattern": "^Interface:\\s*(?P<local_if>\\S+),\\s*Port ID \\(outgoing port\\):\\s*(?P<neighbor_port>\\S+)",
        "mode": "set"
      }
    ],
    "emitWhen": ["neighbor_name", "local_if"]
  },
  "description": "Cisco CDP 邻居详情解析模板"
}

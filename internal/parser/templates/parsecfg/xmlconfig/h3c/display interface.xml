<!DOCTYPE CommandParseConfig SYSTEM "commandparse.dtd">
<!--
    非CDATA块中使用正则，需转义的特殊字符：< : &lt;  > : &gt;  &: &amp; ' : &apos; " : &quot;
    CDATA代码块：<![CDATA[正则内容]]>
-->
<!-- 回显样例
Blade0/0/201
Current state: UP
IP packet frame type: Ethernet II, hardware address: xxxx-xxxx-xxxx
Description: Blade0/0/201 Interface
Bandwidth: 100000000 kbps
100Gbps-speed mode, full-duplex mode
Link speed type is autonegotiation, link duplex type is autonegotiation
Current system time:2023-05-04 11:38:11 Beijing+08:00:00
Last time when physical state changed to up:2022-11-02 15:42:55 Beijing+08:00:00
Last time when physical state changed to down:2022-11-02 15:42:48 Beijing+08:00:00
    Last 300 seconds input:  2 packets/sec, 143 bytes/sec
    Last 300 seconds output:  17 packets/sec, 21421 bytes/sec
    Input Dp: 97698874 packets, 0 jumboes, 23840107610 bytes
              3236380 broadcasts, 523243 multicasts, 0 pauses
    DropPkts: 0 CrcDrop, 0 IfStateDrop, 0 InputRawDrop
              0 RateCtrlDrop, 0 RemoteNodeDrop
    Input Cp: 0 packets, 0 jumboes, 0 bytes
              0 broadcasts, 0 multicasts, 0 pauses
    DropPkts: 0 CrcDrop, 0 IfStateDrop, 0 InputRawDrop
              0 RateCtrlDrop, 0 RemoteNodeDrop
    Output: 334845854 packets, 359799035083 bytes
            3234321 broadcasts, 0 multicasts, 0 pauses
-->
<CommandParseConfig>
    <SegmentParse>
        <Regex>
            ^ {0,100}([0-9A-Za-z-\|]{1,100}\d{1,10}(/\d{1,10})?(/\d{1,10})?(/\d{1,10})?((:|\.)\d{1,10})?
            (?: {0,255}[\r\n]{1,5}.{1,1000})?[ \r\n]{0,255}current[ \r\n]{0,255}state.{0,1000})$
        </Regex>
        <ParseNode name="neInterfaceNode">
            <ConfigParsePolicy>
                <Field name="interfaceName,ifAdminStatus,ifPhyStatus">
                    <Regex>
                        <![CDATA[
                        ^ {0,100}(?<interfaceName>[0-9A-Za-z\|-]{1,100}[A-Za-z]\d{1,10}(/\d{1,10})?(/\d{1,10})?(/(\d{1,10}))?((:|\.)\d{1,10})?)
                        (?: {0,255}[\r\n]{1,5}.{1,512})?[ \r\n]{0,255}current[ \r\n]{0,255}state[ \r\n]{0,255}:[ \r\n]{0,255}(?<ifAdminStatus>\w{1,255})?[ \r\n]{0,255}(?<ifPhyStatus>DOWN|UP)
                        ]]>
                    </Regex>
                    <ToUpper name="ifAdminStatus,ifPhyStatus"/>
                    <ValueMapping name="ifAdminStatus" srcValue="ADMINISTRATIVELY" dstValue="Administratively DOWN|Administratively DOWN"/>
                    <SplitField srcField="ifAdminStatus" delimiter="|" dstFields="ifAdminStatus,ifPhyStatus"/>
                </Field>
                <Field name="ifOperStatus">
                    <Regex>
                        <![CDATA[
                            Line[ \r\n]{0,100}protocol[ \r\n]{0,100}(current)?[ \r\n]{0,100}state[ \r\n]{0,100}:[ \r\n]{0,100}(?<ifOperStatus>DOWN|UP)
                        ]]>
                    </Regex>
                    <ToUpper/>
                </Field>
                <Field name="description">
                    <Regex>
                        <![CDATA[
                            Description {0,100}: {0,100}(?<description>.{1,1024})
                        ]]>
                    </Regex>
                </Field>
                <Field name="lastPhysicalUptime">
                    <Regex>
                        <![CDATA[
                            Last time when physical state changed to up {0,100}: {0,100}(?<lastPhysicalUptime>.{1,1024})
                        ]]>
                    </Regex>
                </Field>
                <Field name="lastPhysicalDowntime">
                    <Regex>
                        <![CDATA[
                            Last time when physical state changed to down {0,100}: {0,100}(?<lastPhysicalDowntime>.{1,1024})
                        ]]>
                    </Regex>
                </Field>
                <Field name="inputUtilityRate">
                    <Regex>
                        <![CDATA[
                            ^ {0,255}Input {0,255}(\(total\)|Dp)? {0,255}: {0,255}(?<inputUtilityRate>\d{1,255}) {0,255}packets
                        ]]>
                    </Regex>
                </Field>
                <Field name="outputUtilityRate">
                    <Regex>
                        <![CDATA[
                            ^ *Output {0,255}(\(total\)|Dp)? *: *(?<outputUtilityRate>\d+) *packets
                        ]]>
                    </Regex>
                </Field>
                <Field name="inErrors">
                    <Regex>
                        <![CDATA[
                            ^ *input *: *(?<inErrors>\d+) *input *errors
                        ]]>
                    </Regex>
                </Field>
                <Field name="outErrors">
                    <Regex>
                        <![CDATA[
                            ^ *Output *: *(?<outErrors>\d+) *Output *errors
                        ]]>
                    </Regex>
                </Field>
                <Field name="primaryIpAddr,primaryMask">
                    <Regex>
                        <![CDATA[
                            ^ *Internet {0,255}Address( {0,100}is)? {0,255}:? {0,255}(?<primaryIpAddr>(\d{1,3}\.){3}\d{1,3})/(?<primaryMask>\d{1,10})
                        ]]>
                    </Regex>
                </Field>
                <Field name="maxBandwidth,unit">
                    <Regex>
                        <![CDATA[
                            Bandwidth *: *(?<maxBandwidth>\d{1,100}) *(?<unit>\S{1,100})
                        ]]>
                    </Regex>
                </Field>
            </ConfigParsePolicy>
            <DefaultValue name="ifAdminStatus" value="UP"/>
        </ParseNode>
    </SegmentParse>
</CommandParseConfig>
<!DOCTYPE CommandParseConfig SYSTEM "commandparse.dtd">
<!--
    非CDATA块中使用正则，需转义的特殊字符：< : &lt;  > : &gt;  &: &amp; ' : &apos; " : &quot;
    CDATA代码块：<![CDATA[正则内容]]>
-->
<!-- 回显样例
<SDQD-PSC-ZS2F1-POD1-M-JR-S5130S-1>display transceiver diagnosis interface
Ten-GigabitEthernet1/0/49 transceiver diagnostic information:
  Current diagnostic parameters:
    Temp.(C)   Voltage(V)  Bias(mA)  RX power(dBm)  TX power(dBm)
    38         3.27        35.04     -2.05          -3.38
  Alarm thresholds:
          Temp.(C)   Voltage(V)  Bias(mA)  RX power(dBm)  TX power(dBm)
    High  73         3.80        88.00     2.50           1.00
    Low   -3         2.81        1.00      -16.40         -11.25

HundredGigE4/1/1 transceiver diagnostic information:
  Current diagnostic parameters:
[module]  Temp.(��C) Voltage(V)     Total RX power(dBm)   Total TX power(dBm)
          27         3.38           5.18                  6.26
[channel] Bias(mA)  RX power(dBm)  TX power(dBm)
    1     5.93      -1.21          0.12
    2     5.94      -0.73          0.50
    3     5.93      -0.85          0.07
    4     5.94      -0.59          0.24
  Alarm thresholds:
          Temp.(��C) Voltage(V)  Bias(mA)  RX power(dBm)  TX power(dBm)
    High  80         3.63        12.00     5.40           5.40
    Low   -10        2.97        0.00      -13.30         -11.40
  Warning thresholds:
          Temp.(��C) Voltage(V)  Bias(mA)  RX power(dBm)  TX power(dBm)
    High  75         3.47        10.00     2.40           2.40
    Low   -5         3.13        0.00      -10.30         -8.40
-->
<CommandParseConfig>
    <SegmentParse>
        <Regex>^ *\S+ +transceiver *diagnostic *information</Regex>
        <ParseNode name="ifTransNode">
            <Regex>(RX|TX) +power</Regex>
            <ConfigParsePolicy>
                <Field name="ifName" primary="true">
                    <Regex>
                        <![CDATA[
                        ^ *(?<ifName>\S+) +transceiver *diagnostic *information
                        ]]>
                    </Regex>
                </Field>
                <Field name="biasHighThreshold,defaultRxPowerHighThreshold,defaultTxPowerHighThreshold">
                    <Regex>
                        <![CDATA[
                            ^ *High +\S+ +\S+ +(?<biasHighThreshold>[\d.-]+) +(?<defaultRxPowerHighThreshold>[\d.-]+) +(?<defaultTxPowerHighThreshold>[\d.-]+)
                        ]]>
                    </Regex>
                </Field>
                <Field name="biasLowThreshold,defaultRxPowerLowThreshold,defaultTxPowerLowThreshold">
                    <Regex>
                        <![CDATA[
                            ^ *Low +\S+ +\S+ +(?<biasLowThreshold>[\d.-]+) +(?<defaultRxPowerLowThreshold>[\d.-]+) +(?<defaultTxPowerLowThreshold>[\d.-]+)
                        ]]>
                    </Regex>
                </Field>
            </ConfigParsePolicy>
            <SegmentParse childMutex="true">
                <Regex>^ *(Current diagnostic.*[\r\n]+ *(\[ *module *\] *)?Temp|\[ *channel *\] *Bias)</Regex>
                <ParseNode name="singleInfo">
                    <Regex>^ *Current diagnostic.*[\r\n]+ *(\[ *module *\] *)?Temp</Regex>
                    <ConfigParsePolicy>
                        <Field name="temperature,voltage,bias,rxPower,txPower">
                            <Regex>
                                <![CDATA[
                                ^ *(?<temperature>[\d.-]+) +(?<voltage>[\d.-]+) +(?<bias>[\d.-]+) +(?<rxPower>[\d.-]+) +(?<txPower>[\d.-]+)[ \r\n]*$
                                ]]>
                            </Regex>
                        </Field>
                        <Field name="temperature,voltage">
                            <!--多channel时仅解析温度和电压-->
                            <Regex>
                                <![CDATA[
                                ^ *(?<temperature>[\d.-]+) +(?<voltage>[\d.-]+) +[\d.-]+ +[\d.-]+[ \r\n]*$
                                ]]>
                            </Regex>
                        </Field>
                    </ConfigParsePolicy>
                </ParseNode>
                <ParseNode name="channelInfo">
                    <Regex>^ *\[ *channel *\] *Bias</Regex>
                    <TableLineParsePolicy>
                        <Regex>
                            <![CDATA[
                            ^ *\d+ +(?<bias>[\d.-]+) +(?<rxPower>[\d.-]+) +(?<txPower>[\d.-]+)[ \r\n]*$
                            ]]>
                        </Regex>
                        <Field name="bias,rxPower,txPower"/>
                    </TableLineParsePolicy>
                </ParseNode>
            </SegmentParse>
        </ParseNode>
        <ParseNode name="opticalIfNode">
            <ConfigParsePolicy>
                <Field name="ifName">
                    <Regex>
                        <![CDATA[
                        ^ *(?<ifName>\S+) +transceiver *diagnostic *information
                        ]]>
                    </Regex>
                    <!--接口名称标准化-->
                    <CustomOperator className="com.huawei.ncetools.ipdevicecheckservice.util.IfNameConvertUtil"
                                    methodName="convertIfName"/>
                    <Assign assignMap="vendor:H3C" filterType="NOT_NULL" filterFieldName="ifName" order="-2"/>
                </Field>
            </ConfigParsePolicy>
        </ParseNode>
    </SegmentParse>
</CommandParseConfig>
<!DOCTYPE CommandParseConfig SYSTEM "commandparse.dtd">
<!--
    非CDATA块中使用正则，需转义的特殊字符：< : &lt;  > : &gt;  &: &amp; ' : &apos; " : &quot;
    CDATA代码块：<![CDATA[正则内容]]>
-->
<!-- 回显样例
<BJ-H3C-CR16006-F-01>display current-configuration | include sysname
 sysname BJ-H3C-CR16006-F-01
-->
<CommandParseConfig>
    <SegmentParse>
        <ParseNode name="sysNameNode">
            <ConfigParsePolicy>
                <Field name="sysName">
                    <Regex>
                        <![CDATA[
                        ^ *sysname {1,255}(?<sysName>.{1,1024})
                        ]]>
                    </Regex>
                </Field>
            </ConfigParsePolicy>
        </ParseNode>
    </SegmentParse>
</CommandParseConfig>
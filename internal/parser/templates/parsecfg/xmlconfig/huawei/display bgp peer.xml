<!DOCTYPE CommandParseConfig SYSTEM "commandparse.dtd">
<!--
    非CDATA块中使用正则，需转义的特殊字符：< : &lt;  > : &gt;  &: &amp; ' : &apos; " : &quot;
    CDATA代码块：<![CDATA[正则内容]]>
-->
<!-- 回显样例
 Status codes: * - Dynamic
 BGP local router ID        : xx.xx.xx.xx
 Local AS number            : 1.45919
 Total number of peers      : 2
 Peers in established state : 2
 Total number of dynamic peers : 0

  Peer                             V          AS  MsgRcvd  MsgSent  OutQ  Up/Down       State  PrefRcv
  xx.xx.xx.xx                     4     1.45886    16103    16334     0 0223h25m Established      743
  xx.xx.xx.xx                    4     1.45886    14525    14486     0 0204h06m Established      739

-->
<CommandParseConfig>
    <SegmentParse>
        <ParseNode name="bgpPeerNode">
            <TableLineParsePolicy>
                <Regex>
                    <![CDATA[
                    ^ {0,255}(?<peer>(\d{1,3}\.){3}\d{1,3}) {1,255}\S{1,255} {1,255}(?<as>\S+) {1,255}(?<msgRcvd>\d+) {1,255}(?<msgSend>\d+) {1,255}(?<outQ>\S+) {1,255}
                    (?<upDown>\S+) {1,255}(?<state>.{1,255}?) {1,255}(?<prefRcv>\d+)
                    ]]>
                </Regex>
                <Field name="peer,as,msgRcvd,msgSend,outQ,upDown,state,prefRcv"/>
            </TableLineParsePolicy>
        </ParseNode>
    </SegmentParse>
</CommandParseConfig>
<!DOCTYPE CommandParseConfig SYSTEM "commandparse.dtd">
<!--
    非CDATA块中使用正则，需转义的特殊字符：< : &lt;  > : &gt;  &: &amp; ' : &apos; " : &quot;
    CDATA代码块：<![CDATA[正则内容]]>
-->
<!-- 回显样例
show mac table
Total MAC address : 495

MAC            VLAN Outgoing Information         Attribute      From Time
xxxx.xxxx.xxxx 354  smartgroup1                  Dynamic        0    00:00:00:00
xxxx.xxxx.xxxx 354  smartgroup1                  Dynamic        0    00:00:00:00

-->
<CommandParseConfig>
    <SegmentParse childMutex="true">
        <ParseNode name="macNode">
            <TableLineParsePolicy>
                <Regex>
                    <![CDATA[
                    ^ *(?<mac>[a-f0-9.:-]+) +(?:(?<vlanId>\d+)|-) +(?<ifName>\S+) +(?<type>\S+) +
                    ]]>
                </Regex>
                <Field name="mac,vlanId,ifName,type"/>
            </TableLineParsePolicy>
        </ParseNode>
    </SegmentParse>
</CommandParseConfig>
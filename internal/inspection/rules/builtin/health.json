  {
    "checkno": "HEALTH-017",
    "title": { "zh": "接口 CRC 错包统计", "en": "Interface CRC error check" },
    "category": "Health",
    "riskLevel": "major",
    "commands": ["display interface"],
    "scope": { "vendors": ["huawei", "h3c", "cisco"] },

[
  {
    "checkno": "HEALTH-001",
    "title": { "zh": "CPU 5分钟平均利用率检查", "en": "CPU 5-minute average utilization check" },
    "category": "Health",
    "riskLevel": "critical",
    "commands": ["display cpu-usage"],
    "scope": { "vendors": ["huawei", "h3c"] },
    "extract": {
      "fields": [{ "name": "cpu_usage", "pattern": "(?:CPU usage|CPU Utilization)\\s*:\\s*([0-9.]+)%", "group": 1 }]
    },
    "assert": { "type": "threshold", "field": "cpu_usage", "expr": 85.0, "operator": "<=" },
    "advice": { "zh": "CPU利用率超过85%，请排查突发流量、广播风暴或异常高消耗进程", "en": "CPU utilization exceeds 85%, please inspect high usage processes" }
  },
  {
    "checkno": "HEALTH-002",
    "title": { "zh": "内存使用率检查", "en": "Memory utilization check" },
    "category": "Health",
    "riskLevel": "critical",
    "commands": ["display memory-usage"],
    "scope": { "vendors": ["huawei", "h3c"] },
    "extract": {
      "fields": [{ "name": "mem_usage", "pattern": "(?:Memory Using Percentage|Memory utilization)\\s*:\\s*([0-9.]+)%", "group": 1 }]
    },
    "assert": { "type": "threshold", "field": "mem_usage", "expr": 80.0, "operator": "<=" },
    "advice": { "zh": "内存使用率超过80%，请核查是否存在内存泄漏或大表项膨胀", "en": "Memory utilization exceeds 80%, please check memory leak or routing table size" }
  },
  {
    "checkno": "HEALTH-003",
    "title": { "zh": "电源模块运行状态", "en": "Power supply module health status" },
    "category": "Health",
    "riskLevel": "critical",
    "commands": ["display power"],
    "scope": { "vendors": ["huawei", "h3c"] },
    "extract": {
      "fields": [{ "name": "power_status", "pattern": "Power\\s+\\S+\\s+(Normal|Abnormal|Fail|Fault|Off)", "group": 1 }]
    },
    "assert": { "type": "must_not_contain", "field": "power_status", "expr": "Fail" },
    "advice": { "zh": "检测到电源异常或断电告警，请核实机房供电与电源冗余", "en": "Power module failure detected, check power supply" }
  },
  {
    "checkno": "HEALTH-004",
    "title": { "zh": "风扇模块运行状态", "en": "Fan module health status" },
    "category": "Health",
    "riskLevel": "major",
    "commands": ["display fan"],
    "scope": { "vendors": ["huawei", "h3c"] },
    "extract": {
      "fields": [{ "name": "fan_status", "pattern": "Fan\\s+\\S+\\s+(Normal|Abnormal|Fail|Fault|Stopped)", "group": 1 }]
    },
    "assert": { "type": "must_not_contain", "field": "fan_status", "expr": "Fail" },
    "advice": { "zh": "风扇出现故障或停转，请及时清理积灰或更换风扇模块", "en": "Fan failure detected, replace fan module" }
  },
  {
    "checkno": "HEALTH-005",
    "title": { "zh": "主控板温度监控", "en": "Main control board temperature check" },
    "category": "Health",
    "riskLevel": "major",
    "commands": ["display temperature"],
    "scope": { "vendors": ["huawei", "h3c"] },
    "extract": {
      "fields": [{ "name": "temperature", "pattern": "(?:Current Temperature|Temperature)\\s*:\\s*([0-9.]+)\\s*(?:C|Celsius)", "group": 1 }]
    },
    "assert": { "type": "threshold", "field": "temperature", "expr": 75.0, "operator": "<=" },
    "advice": { "zh": "主控板工作温度超过75℃警戒线，需检查机房空调制冷", "en": "Board temperature exceeds 75C, check datacenter cooling" }
  },
  {
    "checkno": "HEALTH-006",
    "title": { "zh": "存储介质剩余空间", "en": "Flash storage available space check" },
    "category": "Health",
    "riskLevel": "major",
    "commands": ["dir"],
    "scope": { "vendors": ["huawei", "h3c"] },
    "extract": {
      "fields": [{ "name": "flash_free_kb", "pattern": "([0-9,]+)\\s*KB free", "group": 1 }]
    },
    "assert": { "type": "must_not_contain", "field": "", "expr": "0 KB free" },
    "advice": { "zh": "Flash存储空间耗尽，需清理历史系统日志和多余安装包", "en": "Flash space exhausted, delete old core logs and packages" }
  },
  {
    "checkno": "HEALTH-007",
    "title": { "zh": "单板告警与异常状态", "en": "Device board status check" },
    "category": "Health",
    "riskLevel": "critical",
    "commands": ["display device"],
    "scope": { "vendors": ["huawei", "h3c"] },
    "extract": {
      "fields": [{ "name": "board_status", "pattern": "\\b(Unregistered|Fault|Abnormal|Offline)\\b", "group": 1 }]
    },
    "assert": { "type": "must_not_contain", "field": "board_status", "expr": "Fault" },
    "advice": { "zh": "单板存在 Fault 故障状态，需重新插拔或联系技术支持", "en": "Board in Fault state, check connection or replace" }
  },
  {
    "checkno": "HEALTH-008",
    "title": { "zh": "光模块接收光功率低门限检查", "en": "Optical transceiver Rx power low alarm check" },
    "category": "Health",
    "riskLevel": "major",
    "commands": ["display optical-module"],
    "scope": { "vendors": ["huawei"] },
    "extract": {
      "fields": [{ "name": "rx_power", "pattern": "Rx Power\\(dBm\\)\\s*:\\s*([-0-9.]+)", "group": 1 }]
    },
    "assert": { "type": "threshold", "field": "rx_power", "expr": -22.0, "operator": ">=" },
    "advice": { "zh": "光模块接收功率过低(<-22dBm)，存在弱光风险，需清洁光纤端面或更换光纤跳线", "en": "Optical Rx power too low, clean fiber connector" }
  },
  {
    "checkno": "HEALTH-009",
    "title": { "zh": "光模块发送光功率低门限检查", "en": "Optical transceiver Tx power low alarm check" },
    "category": "Health",
    "riskLevel": "major",
    "commands": ["display optical-module"],
    "scope": { "vendors": ["huawei"] },
    "extract": {
      "fields": [{ "name": "tx_power", "pattern": "Tx Power\\(dBm\\)\\s*:\\s*([-0-9.]+)", "group": 1 }]
    },
    "assert": { "type": "threshold", "field": "tx_power", "expr": -12.0, "operator": ">=" },
    "advice": { "zh": "光模块发送光功率异常跌落，提示光模块发射端发光老化", "en": "Optical Tx power below normal threshold" }
  },
  {
    "checkno": "HEALTH-010",
    "title": { "zh": "系统活动告警检查", "en": "System active alarm check" },
    "category": "Health",
    "riskLevel": "critical",
    "commands": ["display alarm active"],
    "scope": { "vendors": ["huawei", "h3c"] },
    "extract": {
      "fields": [{ "name": "active_alarms", "pattern": "(Critical|Major)\\s+alarm", "group": 1 }]
    },
    "assert": { "type": "must_not_contain", "field": "", "expr": "Critical" },
    "advice": { "zh": "设备当前存在 Critical 级别活动告警，请在网管或控制台确认处理", "en": "Critical active alarm present on device" }
  },
  {
    "checkno": "HEALTH-011",
    "title": { "zh": "接口丢包率与错包率", "en": "Interface packet error rate check" },
    "category": "Health",
    "riskLevel": "major",
    "commands": ["display interface brief"],
    "scope": { "vendors": ["huawei", "h3c"] },
    "extract": {
      "fields": [{ "name": "in_errors", "pattern": "([0-9]+)\\s+input errors", "group": 1 }]
    },
    "assert": { "type": "threshold", "field": "in_errors", "expr": 100.0, "operator": "<=" },
    "advice": { "zh": "接口存在持续性输入错包，可能为物理网线损伤或双工不匹配", "en": "Interface has high input errors, check physical cable" }
  },
  {

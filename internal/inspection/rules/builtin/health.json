    "advice": { "zh": "ARP 表项接近规格上限，注意防范 ARP 泛洪攻击", "en": "ARP table entries approaching capacity" }
  },
  {
    "checkno": "HEALTH-014",
    "title": { "zh": "MAC 表项容量监控", "en": "MAC address table capacity check" },
